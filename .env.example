# Internal Vikunja API address visible to this container. Keep it off the public Internet.
VIKUNJA_BASE_URL=http://vikunja:3456

# Dedicated Vikunja integration token. Do not reuse a human or another integration token.
VIKUNJA_MCP_API_TOKEN=
# Preferred in production: point to a mounted Docker secret file instead of
# placing the value in an environment variable. If both are present, _FILE wins.
VIKUNJA_MCP_API_TOKEN_FILE=

# Comma-separated Vikunja project IDs exposed through this MCP server, or `all`
# for every project the dedicated integration user can access.
VIKUNJA_ALLOWED_PROJECT_IDS=7

# Existing Vikunja user ID that receives Admin access whenever
# create_project creates a project. This is not a general sharing feature.
VIKUNJA_MCP_OWNER_USER_ID=

# Cloudflare Zero Trust team domain and the Access application's Audience (AUD) tag.
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=

# Comma-separated identities that the origin accepts after JWT verification.
CF_ACCESS_ALLOWED_EMAILS=owner@example.com

# Optional exact browser Origin allowlist for POST /mcp. Requests without an
# Origin header remain valid for non-browser MCP clients such as ChatGPT.
MCP_ALLOWED_ORIGINS=

# Bounded remote calls and pagination. GET requests are never retried by this
# adapter; writes are sent once only.
VIKUNJA_REQUEST_TIMEOUT_MS=10000
CF_ACCESS_JWKS_TIMEOUT_MS=5000
VIKUNJA_PAGE_SIZE=50
VIKUNJA_MAX_PAGES=20
VIKUNJA_MAX_RESULTS=1000

# Writes are deliberately off by default. Enabling them also requires a separate allowlist.
MCP_WRITE_ENABLED=false
MCP_WRITE_ALLOWED_EMAILS=

# Container listener; do not publish it as a host port.
PORT=3000
